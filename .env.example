# API
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Base URL used for links in responses
PUBLIC_URL=http://localhost:3000
# false, true, a hop count, or proxy addresses/subnets (e.g. loopback,10.0.0.0/8)
TRUST_PROXY=false
# Without Redis, player lookups are cached in memory
REDIS_HOST=
# REDIS_URL=redis://localhost:6379
# Version served by the v1 routes
LEGACY_VERSION=1.21.5

# Shared by the API and the pipeline
DATA_DIR=data

# Pipeline
PIPELINE_MIN_VERSION=1.21.4
# release, snapshot
PIPELINE_TYPES=release
PIPELINE_INTERVAL_MINUTES=60
# Keep downloaded client jars in DATA_DIR/cache/jars
PIPELINE_KEEP_JARS=false
